{
  "name": "rambutan",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:client": "pnpm --dir client dev",
    "dev:server": "pnpm --dir server dev",
    "migrate": "pnpm --dir server migrate",
    "build": "pnpm -r build",
    "lint": "pnpm lint:client && pnpm lint:server",
    "lint:client": "pnpm --dir client lint",
    "lint:server": "./client/node_modules/.bin/eslint ./server",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "docker:setup": "if [ ! -f .env ]; then cp .env.example .env && echo 'Created .env. Set its required values, then rerun: pnpm docker:setup'; else docker compose up --build -d && pnpm docker:migrate; fi",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:migrate": "docker compose run --rm server node dist/database/runMigrations.js",
    "docker:dev": "if [ ! -f .env ]; then cp .env.example .env && echo 'Created .env. Set its required values, then rerun: pnpm docker:dev'; else docker compose -f compose.dev.yaml up --build; fi",
    "docker:dev:down": "docker compose -f compose.dev.yaml down",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript-eslint": "^8.61.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx,json,md,css,yaml,yml,webmanifest}": "prettier --write",
    "client/**/*.{js,jsx,ts,tsx}": "pnpm --dir client exec eslint --fix",
    "server/**/*.{js,ts}": "./client/node_modules/.bin/eslint --fix"
  }
}
